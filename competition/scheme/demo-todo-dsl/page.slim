#lang (creme syntax slim) (export page) (params css rows count-text)
= (list 'raw "<!DOCTYPE html>")
html
  head
    meta(charset="utf-8")
    title Todo List
    style
      = (list 'raw css)
  body
    div.todo-app
      h1 Todo List
      form.add(method="post" action="/todos")
        input(type="text" name="title" placeholder="New todo" required)
        button(type="submit") Add
      ul.todos
        = rows
      p.count = count-text
