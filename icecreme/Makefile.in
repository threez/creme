CC ?= @CC@

# Boehm GC (the same collector Crystal itself uses, via the bdwgc/libgc
# package) -- every heap allocation in icecreme goes through GC_MALLOC/GC_REALLOC
# instead of a hand-rolled arena; see vm.h's VM struct doc comment for why
# the VM struct itself is GC_MALLOC'd rather than calloc'd.
#
# (creme actor) (actor.c) needs the THREADED build specifically --
# GC_register_my_thread/GC_pthread_create etc. are compiled out of a
# plain (non-threaded) libgc entirely. Some distros bake pthread support
# into their one bdw-gc package unconditionally; others (e.g. this
# project's own FreeBSD dev environment) ship it as a separate
# bdw-gc-threaded package/pkg-config name -- try that first, falling back
# to plain bdw-gc for the former. -DGC_THREADS makes gc.h itself expose
# the thread-registration API's declarations (gated behind that macro);
# if it's defined but the linked libgc DOESN'T actually have pthread
# support compiled in, that's a real, loud link error (undefined
# GC_register_my_thread) rather than a silent runtime one -- correct
# behavior, since actor.c genuinely cannot work without it.
#
# GC_PKG_CFLAGS/GC_LIBS (and every other *_CFLAGS/*_LIBS below down through
# ZSTD_LIBS, plus EXECINFO_LIBS) are resolved by ./configure, NOT by a Make-
# level `!=` shell-assignment -- see configure.ac's own header comment for
# why: `!=` isn't supported by every make this project needs to run under
# (specifically, Apple's stock macOS make, a GNU Make frozen at 3.81 for
# licensing reasons, predates `!=` -- added in GNU Make 4.0), and there's no
# single Make-level construct that works on both that AND real BSD make.
# Resolving these in configure's own portable shell sidesteps the conflict
# entirely, since these are genuine build-time constants (unlike
# HDRS/ICECREME_COMPILER_SLDS near the bottom, which must stay dynamic --
# see their own comment).
GC_PKG_CFLAGS = @GC_PKG_CFLAGS@
GC_CFLAGS = $(GC_PKG_CFLAGS) -DGC_THREADS
GC_LIBS = @GC_LIBS@

# PCRE2 -- backs (creme regex)'s `regexp`/`regexp-matches?` (regex.c),
# needed only so the self-hosted reader (modules/creme/compiler/
# reader.sld) can run under icecreme; see regex.c's own header comment for why
# PCRE2 specifically (matches the real Crystal Regex class's own flavor).
PCRE2_CFLAGS = @PCRE2_CFLAGS@
PCRE2_LIBS = @PCRE2_LIBS@

# GMP -- backs T_RATIONAL's arbitrary-precision mpq_t (value.h); see
# builtins.c's num_add/num_div/etc. and main.c's mp_set_memory_functions
# call (redirects GMP's own allocator to GC_MALLOC/GC_REALLOC so an mpq_t's
# limbs are reclaimed by the same Boehm GC as everything else here).
GMP_CFLAGS = @GMP_CFLAGS@
GMP_LIBS = @GMP_LIBS@

# OpenSSL libcrypto -- backs (creme actor)'s TCP/Unix transport HMAC-SHA256
# handshake (actor.c's Phase 4, HMAC()/RAND_bytes()), mirroring native's own
# openssl/hmac + random/secure usage (actor.cr).
CRYPTO_CFLAGS = @CRYPTO_CFLAGS@
# _RAW because the link-time list is gated below (LDLIBS_GATED_SH) by whether
# any openssl-touching family is enabled -- keeping the raw pkg-config result
# under its own name avoids a self-referential reassignment.
CRYPTO_LIBS_RAW = @CRYPTO_LIBS_RAW@

# OpenSSL libssl -- (creme http)'s HTTPS client path (http.c), the actual
# SSL/TLS layer that project used to leave untouched (libcrypto above was
# already linked, just never for TLS itself).
SSL_CFLAGS = @SSL_CFLAGS@
SSL_LIBS_RAW = @SSL_LIBS_RAW@

# libffi -- backs (creme ffi)'s ffi-function/ffi-call (creme_ffi.c), the
# generic dlopen/native-call bridge. dlopen/dlsym/dlclose themselves come
# from libc directly on this project's FreeBSD dev environment, but -ldl
# is a no-op there anyway, required on glibc Linux systems older than the
# libc/libdl merge -- gated below alongside -lffi (CREME_WITH_FFI), since
# creme_ffi.c is the only consumer of either.
FFI_CFLAGS = @FFI_CFLAGS@
FFI_LIBS = @FFI_LIBS@

# libyaml (MIT) -- backs (creme yaml)'s yaml-read/yaml-write (yaml.c),
# same pkg-config-with-a-fallback pattern as PCRE2/GMP/OpenSSL/libffi
# above. Native's own (creme yaml) (src/creme/modules/creme/yaml.cr)
# leans on Crystal's bundled `YAML` stdlib module, itself a libyaml
# wrapper -- so both backends end up linking the same underlying C
# library either way; see yaml.c's own header comment.
YAML_CFLAGS = @YAML_CFLAGS@
YAML_LIBS = @YAML_LIBS@

# libzstd (facebook/zstd, BSD-3-Clause) -- backs (creme zstd)'s zstd-compress/
# zstd-decompress (zstd.c), same pkg-config-with-a-fallback pattern as libyaml
# above. Native's own (creme zstd) (src/creme/modules/creme/zstd.cr) binds the
# same libzstd one-shot API directly, so both backends link the same underlying
# C library either way; see zstd.c's own header comment.
ZSTD_CFLAGS = @ZSTD_CFLAGS@
ZSTD_LIBS = @ZSTD_LIBS@

# Verstable (vendor/verstable/verstable.h, MIT, single header, no deps) --
# backs (creme hash-table)'s Value->Value map (hashtable.c). Header-only, so
# no separate object file, just an include path (below).
#
# sds (vendor/sds/{sds.c,sds.h,sdsalloc.h}, BSD-2-Clause) -- backs (creme
# string)/(creme format)'s growable string-building buffer (strings.c) AND
# mux.c's own request-read/response-write buffers (see mux.c's own header
# comment). sdsalloc.h is edited in-tree to route s_malloc/s_realloc/s_free
# through GC_MALLOC/GC_REALLOC/GC_FREE instead of libc, since every sds
# buffer here is only ever reachable from a plain GC_MALLOC'd Value or a
# short-lived C stack variable.
#
# picohttpparser (vendor/picohttpparser/{picohttpparser.c,.h}, MIT/Perl
# dual-licensed, no deps) -- backs (creme mux)'s HTTP/1.1 request-line/
# header parsing (mux.c), which multiplexes every connection through a
# single poll(2) loop (see mux.c's own header comment for the full
# dispatch design, including its optional worker-VM pool).
# ---- Optional native builtin families (icecreme/builtin_config.h) ---------
# Each of these gates one family's .c file down to an empty translation
# unit (that file's own `#if CREME_WITH_<NAME>` wrapper) and its
# BUILTIN_FAMILIES table row (builtin_families.c) -- defaulting to 1
# (included), matching every prior release's "everything always in"
# behavior. Resolved by ./configure now (--disable-sql/--disable-http/etc.
# -- see configure.ac's own header comment for the full list and why: a
# persistent, `./configure --help`-discoverable choice instead of a Make
# flag you have to remember to repeat every invocation). Still overridable
# on the `make` command line exactly as before too, e.g. `make lib
# CREME_WITH_SQL=0 CREME_WITH_HTTP=0` for a ONE-OFF trimmed libcreme.a build
# without reconfiguring -- a variable given on the make command line always
# wins over an in-Makefile assignment regardless of operator (see
# examples/libcream/Makefile for a full minimal-dependency build, and
# icecreme/README.md's "Embedding" section for the complete family list).
# Flipping these off for the default `all`/CLI target works too, but isn't
# the primary use case -- the CLI is meant to stay full-featured; these
# knobs exist mainly for `make lib` embedders who want a trimmed library.
CREME_WITH_SQL = @CREME_WITH_SQL@
CREME_WITH_HTTP = @CREME_WITH_HTTP@
CREME_WITH_CIPHER = @CREME_WITH_CIPHER@
CREME_WITH_PKEY = @CREME_WITH_PKEY@
CREME_WITH_X509 = @CREME_WITH_X509@
CREME_WITH_DIGEST = @CREME_WITH_DIGEST@
CREME_WITH_SECURE_RANDOM = @CREME_WITH_SECURE_RANDOM@
CREME_WITH_ACTOR = @CREME_WITH_ACTOR@
CREME_WITH_FFI = @CREME_WITH_FFI@
CREME_WITH_YAML = @CREME_WITH_YAML@
CREME_WITH_MUX = @CREME_WITH_MUX@
CREME_WITH_CSV = @CREME_WITH_CSV@
CREME_WITH_TREELIST = @CREME_WITH_TREELIST@
CREME_WITH_JSON = @CREME_WITH_JSON@
CREME_WITH_BIGDECIMAL = @CREME_WITH_BIGDECIMAL@
CREME_WITH_TERM = @CREME_WITH_TERM@
CREME_WITH_PROCESS = @CREME_WITH_PROCESS@
CREME_WITH_STRING = @CREME_WITH_STRING@

FEATURE_DEFINES := \
  -DCREME_WITH_SQL=$(CREME_WITH_SQL) -DCREME_WITH_HTTP=$(CREME_WITH_HTTP) \
  -DCREME_WITH_CIPHER=$(CREME_WITH_CIPHER) -DCREME_WITH_PKEY=$(CREME_WITH_PKEY) \
  -DCREME_WITH_X509=$(CREME_WITH_X509) -DCREME_WITH_DIGEST=$(CREME_WITH_DIGEST) \
  -DCREME_WITH_SECURE_RANDOM=$(CREME_WITH_SECURE_RANDOM) -DCREME_WITH_ACTOR=$(CREME_WITH_ACTOR) \
  -DCREME_WITH_FFI=$(CREME_WITH_FFI) -DCREME_WITH_YAML=$(CREME_WITH_YAML) \
  -DCREME_WITH_MUX=$(CREME_WITH_MUX) -DCREME_WITH_CSV=$(CREME_WITH_CSV) \
  -DCREME_WITH_TREELIST=$(CREME_WITH_TREELIST) -DCREME_WITH_JSON=$(CREME_WITH_JSON) \
  -DCREME_WITH_BIGDECIMAL=$(CREME_WITH_BIGDECIMAL) -DCREME_WITH_TERM=$(CREME_WITH_TERM) \
  -DCREME_WITH_PROCESS=$(CREME_WITH_PROCESS) -DCREME_WITH_STRING=$(CREME_WITH_STRING)

# Link-time gating to match: -lcrypto stays linked if ANY openssl-touching
# family is on; -lssl only if http (the sole TLS consumer) is on. -lpthread/
# $(GC_LIBS)/$(GMP_LIBS)/$(PCRE2_LIBS)/$(ZSTD_LIBS) stay unconditional
# (pthread is tied to GC_THREADS regardless of actor/mux; gmp/pcre2/zstd are
# hard, non-gateable dependencies -- T_RATIONAL/`regex`/the ICE bytecode
# container format respectively).
#
# LDLIBS_GATED_SH is plain text (an ordinary `=` macro -- make never executes
# it directly) holding a shell snippet that decides, AT LINK TIME, which
# optional libs actually get linked; each of the 4 link recipes below splices
# its stdout in via `$$(...)` shell command substitution, evaluated by the
# recipe's own /bin/sh. That sidesteps `!=` (and GNU's `$(shell ...)`, which
# BSD make lacks) entirely for this piece -- plain macro text expansion plus
# a shell command substitution inside a recipe are both universal, unlike
# shell-output assignment at the Make level itself (see configure.ac's header
# comment for why `!=`/`$(shell)` aren't both available everywhere). `$$v`
# is a shell variable ($$-escaped so make passes it through unexpanded).
# Command-line overrides (e.g. `make CREME_WITH_HTTP=0`) still take effect,
# since $(CREME_WITH_*) expands into the snippet's text before the shell
# ever runs it. Trailing `:` (shell no-op) keeps the substitution's exit
# status 0 even when every family is off.
LDLIBS_GATED_SH = \
  [ "$(CREME_WITH_SQL)" != 0 ] && echo -lsqlite3; \
  [ "$(CREME_WITH_HTTP)" != 0 ] && echo "$(SSL_LIBS_RAW)"; \
  for v in $(CREME_WITH_HTTP) $(CREME_WITH_CIPHER) $(CREME_WITH_PKEY) $(CREME_WITH_X509) $(CREME_WITH_DIGEST) $(CREME_WITH_SECURE_RANDOM) $(CREME_WITH_ACTOR); do [ "$$v" != 0 ] && { echo "$(CRYPTO_LIBS_RAW)"; break; }; done; \
  [ "$(CREME_WITH_FFI)" != 0 ] && echo "$(FFI_LIBS) -ldl"; \
  [ "$(CREME_WITH_YAML)" != 0 ] && echo "$(YAML_LIBS)"; \
  :

# Mandatory build flags -- the -std/-I include paths, pkg-config cflags, and
# feature defines the build genuinely cannot compile without. Kept in their OWN
# variable (not CFLAGS) and always applied by every recipe as `$(CREME_CFLAGS)
# $(CFLAGS)`, because BSD make PREDEFINES CFLAGS (to `-O2 -pipe` via sys.mk),
# which would defeat a plain `CFLAGS ?= ...` default and silently drop all of
# these. User $(CFLAGS) is appended after, so it still tunes/overrides (e.g.
# `make CFLAGS=-O0`) without clobbering the mandatory set.
#
# -D_DEFAULT_SOURCE: needed on glibc for struct sigaction's fields (vm.h's
# old_sigprof_action, profiler.c's SIGPROF handling) to be visible under
# plain -std=c11 -- glibc gates <signal.h>'s full POSIX surface behind a
# feature-test macro there, unlike FreeBSD/Darwin libc, which expose it
# unconditionally (so this was never caught until icecreme was first built
# on Linux CI). Specifically _DEFAULT_SOURCE, NOT _XOPEN_SOURCE: an
# earlier attempt at this fix used -D_XOPEN_SOURCE=700, which does widen
# glibc's namespace enough for struct sigaction, but ALSO narrows FreeBSD's
# libc (and likely Darwin's) into strict X/Open conformance mode, hiding
# mux.c's own BSD-only SO_REUSEPORT/_SC_NPROCESSORS_ONLN and breaking that
# build -- a real regression this project's own FreeBSD/macOS CI legs
# caught. _DEFAULT_SOURCE is glibc-specific (glibc's own "restore the
# implicit default namespace -std= would otherwise narrow" macro); FreeBSD
# and Darwin's libc's don't gate anything behind it at all, so defining it
# there is a harmless no-op -- no platform conditional needed. A
# per-.c-file #define isn't a reliable fix on its own either way: a
# feature-test macro only takes effect if set before a translation unit's
# FIRST system header, and every .c file that (transitively, via vm.h/
# embed.h) needs this already includes several plain system headers of its
# own first -- a -D flag applied to every compile, before any source is
# even read, is the only fix that can't be defeated by include order.
# builtins.c's own earlier, narrower #define _XOPEN_SOURCE 700 (added for
# strptime(3), predates this) is untouched and still needed there (glibc's
# strptime specifically wants _XOPEN_SOURCE, not _DEFAULT_SOURCE) --
# harmless alongside this flag, since the two macros are independent.
#
# -D_GNU_SOURCE: needed on glibc for profiler.c's Dl_info/dladdr(3) (used
# to symbolize native stack samples for --profile) -- dladdr is a GNU/
# glibc extension, not POSIX/XSI, so _DEFAULT_SOURCE alone (above) doesn't
# expose it there; FreeBSD/Darwin libc's expose dladdr unconditionally
# regardless of any feature-test macro. Same no-platform-conditional-
# needed reasoning as _DEFAULT_SOURCE: glibc-specific, harmless no-op on
# FreeBSD/Darwin since neither gates anything behind it.
CREME_CFLAGS = -std=c11 -O2 -g -fno-omit-frame-pointer -Wall -Wextra -Wno-missing-field-initializers \
               -D_DEFAULT_SOURCE -D_GNU_SOURCE \
               -Ivendor/verstable -Ivendor/sds -Ivendor/picohttpparser \
               $(GC_CFLAGS) $(PCRE2_CFLAGS) $(GMP_CFLAGS) $(CRYPTO_CFLAGS) $(SSL_CFLAGS) $(FFI_CFLAGS) $(YAML_CFLAGS) $(ZSTD_CFLAGS) \
               $(FEATURE_DEFINES)
# -rdynamic: exports the executable's own (non-imported) symbols into its
# dynamic symbol table so dladdr(3) can resolve them on Linux/glibc — a no-op
# on Darwin, where dladdr already sees the main binary's local symbol table.
# Mandatory (same BSD-predefined-LDFLAGS reasoning as CREME_CFLAGS); user
# $(LDFLAGS) is appended by the link recipes.
CREME_LDFLAGS = -rdynamic
# backtrace(3)/execinfo.h (profiler.c's SIGPROF sampler) ship inside libc on
# Linux/glibc and Darwin, but FreeBSD splits them into their own libexecinfo
# (part of the base system, not a package) — link it there only, so this
# stays a no-op everywhere else. Resolved by ./configure (a plain uname
# check, no pkg-config involved) -- see this file's own top comment for why.
EXECINFO_LIBS = @EXECINFO_LIBS@
LDLIBS := -lm -lpthread $(GC_LIBS) $(PCRE2_LIBS) $(GMP_LIBS) $(ZSTD_LIBS) $(EXECINFO_LIBS)

# embedded_icecreme.c (bin2c of icecreme.ice, generated below) is in
# the CLI's own SRCS now, not just the library's: main.c's no-args REPL mode
# loads the compiler-mode driver from these embedded bytes rather than reading
# icecreme/icecreme.ice off disk (the file-based compiler mode below still
# reads it from disk, unchanged). This makes `make all` depend on regenerating
# icecreme.ice from the committed bootstrap seed (see "Self-hosting bootstrap"
# below), the same build-time dependency the `lib` target already had.
# Source decomposition. main.c (the CLI entry) and embedded_icecreme.c (the
# bin2c'd self-hosted-compiler image) are split into their own vars so the
# fuzz/lib/boot variants below can be plain concatenations -- BSD make has no
# `$(filter-out ...)` to subtract one entry from a list. sds is compiled from a
# staging dir ($(SDS_STAGE)) that pairs it with a generated GC-backed sdsalloc.h,
# so the pinned sds submodule stays byte-for-byte pristine (see the "Vendored
# deps" section near the bottom); picohttpparser compiles in place.
SDS_STAGE = sds-gc
MAIN_SRC  = main.c
EMBED_SRC = embedded_icecreme.c
COMMON_SRCS = loader.c vm.c builtins.c hashtable.c sql.c mux.c strings.c profiler.c bootstrap.c regex.c process.c csv.c treelist.c actor.c digest.c json.c bigdecimal.c http.c term.c creme_ffi.c yaml.c zstd.c secure_random.c cipher.c pkey.c x509.c builtin_families.c \
              $(SDS_STAGE)/sds.c vendor/picohttpparser/picohttpparser.c
SRCS = $(MAIN_SRC) $(COMMON_SRCS) $(EMBED_SRC)
OBJS = $(SRCS:.c=.o)
BIN = icecreme

# ASAN+UBSAN diagnostic build -- a separate object suffix (.san.o) and
# binary (icecreme-sanitize) so `make` and `make sanitize` never share/clobber
# each other's objects and both can exist side by side. -fno-sanitize-
# recover=all: a caught UB/memory error aborts immediately with its report
# instead of letting execution limp on past it (this is a diagnostic build,
# not something meant to run past its first finding). Boehm GC's own
# conservative stack/heap scanning is known to coexist with ASAN in
# practice (both are widely used together upstream); if a run surfaces
# GC-vs-ASAN false positives rather than real bugs, that's the first thing
# to check before treating a report as a genuine icecreme defect.
SANITIZE_FLAGS := -fsanitize=address,undefined -fno-sanitize-recover=all
SANITIZE_OBJS := $(SRCS:.c=.san.o)
SANBIN := icecreme-sanitize

# ---- Portability: GNU make AND BSD make ------------------------------------
# This project's FreeBSD dev box builds with the base-system `make` (BSD make),
# so this file avoids every GNU-only construct: no `$(shell)`/`$(filter*)`/
# `$(if)`/`$(strip)`, and no `%`-pattern rules -- BSD make silently IGNORES a
# `%.o: %.c` rule and falls back to its builtin .c.o suffix rule (wrong
# recipe, no error). Object builds therefore use SUFFIX rules, which both
# makes honor -- including the multi-dot `.c.san.o`/`.c.fuzz.o`/`.c.lib.o`
# forms, once those suffixes are declared. Suffix rules can't carry the old
# `%.o: %.c *.h` header prerequisite inline, so a single shared prereq line
# near the bottom ($(OBJS) ...: $(HDRS) ...) gives every object set the same
# "rebuild when any header changes" behavior.
#
# HDRS/ICECREME_COMPILER_SLDS are the two places this Makefile.in genuinely
# still needs a shell-output assignment at Make level (not resolvable by
# ./configure -- see this file's top comment for why) -- @HDRS_ASSIGN@/
# @SLDS_ASSIGN@ are substituted by configure with whichever syntax the local
# make actually supports (`!=` or GNU's `$(wildcard)`/`$(shell)`), decided by
# the probe in configure.ac.
.SUFFIXES: .c .o .san.o .fuzz.o .lib.o
HDRS @HDRS_ASSIGN@

.PHONY: all clean sanitize
all: $(BIN)

$(BIN): $(OBJS)
	$(CC) $(CREME_CFLAGS) $(CFLAGS) -o $@ $(OBJS) $(CREME_LDFLAGS) $(LDFLAGS) $(LDLIBS) $$($(LDLIBS_GATED_SH))

.c.o:
	$(CC) $(CREME_CFLAGS) $(CFLAGS) -c -o $@ $<

sanitize: $(SANBIN)

$(SANBIN): $(SANITIZE_OBJS)
	$(CC) $(CREME_CFLAGS) $(CFLAGS) $(SANITIZE_FLAGS) -o $@ $(SANITIZE_OBJS) $(CREME_LDFLAGS) $(LDFLAGS) $(LDLIBS) $$($(LDLIBS_GATED_SH))

.c.san.o:
	$(CC) $(CREME_CFLAGS) $(CFLAGS) $(SANITIZE_FLAGS) -c -o $@ $<

# libFuzzer harness (fuzz/fuzz_loader.c) targeting creme_load_from_bytes --
# the ICE bytecode deserializer, the one place icecreme treats a byte blob as
# trusted input (see that file's own header comment). Needs clang
# specifically (libFuzzer ships as part of clang's compiler-rt, not a
# separate package, and isn't available through plain gcc/$(CC)) -- a
# distinct object suffix (.fuzz.o) and every non-main .c file re-linked
# in, since fuzz_loader.c supplies its own LLVMFuzzerTestOneInput instead
# of main(). ASAN is included alongside the fuzzer instrumentation so a
# memory-safety bug the fuzzer triggers is caught immediately, not just a
# logic-level "wrong output".
# $(COMMON_SRCS) $(EMBED_SRC) is $(SRCS) minus main.c -- the plain-concatenation
# equivalent of the old `$(filter-out main.c,$(SRCS))` (BSD make has no filter).
FUZZ_SRCS := $(COMMON_SRCS) $(EMBED_SRC)
FUZZ_OBJS := $(FUZZ_SRCS:.c=.fuzz.o)
FUZZBIN := fuzz-loader

.PHONY: fuzz
fuzz: $(FUZZBIN)

$(FUZZBIN): $(FUZZ_OBJS) fuzz/fuzz_loader.c
	clang $(CREME_CFLAGS) $(CFLAGS) -fsanitize=fuzzer,address -o $@ $(FUZZ_OBJS) fuzz/fuzz_loader.c $(CREME_LDFLAGS) $(LDFLAGS) $(LDLIBS) $$($(LDLIBS_GATED_SH))

.c.fuzz.o:
	clang $(CREME_CFLAGS) $(CFLAGS) -fsanitize=fuzzer,address -c -o $@ $<

# ---- libcreme.a: an embeddable static library, plus a self-contained -------
# ---- compiler+REPL bundle, for a host C program (see examples/libcream/) ---
#
# Same `filter-out main.c` shape as the fuzz target above, archived (ar rcs)
# instead of linked into a binary -- one monolithic library, gated by the
# same CREME_WITH_<NAME> family macros as the CLI build above (a caller
# building just `lib` can pass a trimmed CREME_WITH_*=0 set without
# touching `all`'s own object files at all, since .lib.o is its own
# distinct object suffix -- see examples/libcream/Makefile for a concrete
# minimal build). -fPIC on its own object suffix (.lib.o, distinct from
# plain .o/.san.o/.fuzz.o) costs nothing today and leaves the door open to
# a future .so from the same objects.
#
# embed.c/embedded_icecreme.c are library-ONLY additions -- deliberately
# not part of $(SRCS)/the CLI binary, which keeps its own existing
# file-based compiler-mode (main.c's CREME_COMPILER_DRIVER_PATH) completely
# unchanged. Only the self-hosted-compiler driver gets bundled as embedded
# bytes, not the REPL too -- creme_run_repl (embed.c) instead compiles
# icecreme/repl.scm fresh through the same bundled-compiler mechanism at
# call time (a precompiled repl.ice loaded standalone is missing
# interaction-environment -- see embed.c's own comment on creme_run_repl).
# Names tools/bin2c.c explicitly rather than $< -- BSD make only sets $< in
# inference/suffix rules, not explicit ones (where it would expand to empty).
tools/bin2c: tools/bin2c.c
	$(CC) -O2 -o $@ tools/bin2c.c

# ---- Self-hosting bootstrap -------------------------------------------------
# icecreme.scm (the whole CLI: self-hosted compiler + disassembler + dispatcher)
# is compiled to one ICE chunk and bin2c'd into the binary. That compilation is
# done BY ICECREME ITSELF, so building the binary needs a compiler image and the
# image needs a binary. The cycle is broken with a COMMITTED bootstrap seed --
# no native Crystal bin/creme, no toolchain beyond a C compiler:
#
#   stage 0  icecreme-boot : a throwaway binary whose embedded chunk is the
#                            committed seed icecreme-boot.ice (a --static image
#                            checked into the repo). A fresh checkout bootstraps
#                            from this file alone.
#   stage 1  icecreme       : the real binary, whose embedded chunk icecreme-boot
#                            RE-compiles from the CURRENT icecreme.scm with
#                            `--static` (inlines every imported .sld so the image
#                            is self-contained). Because stage 1 recompiles
#                            current source, the binary always reflects edits to
#                            icecreme.scm/*.sld -- the seed is only the bootstrap
#                            root, never the shipped logic. (NOT --strip -- see
#                            the stage-1 recipe comment below for why.)
#
# Soundness rests on the byte-for-byte fixpoint -- icecreme compiling itself
# yields an identical chunk (spec/creme/compiler_self_host_spec.scm), so at
# steady state stage 1's icecreme.ice EQUALS the committed icecreme-boot.ice.
# When you change the compiler's codegen, stage 1's one-pass output diverges from
# a self-emit (the fixpoint spec flags it): run `make update-boot-seed` to refresh
# the committed seed from the freshly built compiler, then rebuild + commit it.
#
# ICECREME_COMPILER_SLDS is space-joined onto one line because a `!=`/`$(shell)`
# variable holding find's default newline-separated output breaks BSD make's
# prerequisite-list parsing (each newline reads as a bare, unmatchable
# prerequisite) -- same portable idiom the root Makefile's CREME_SRCS uses.
# @SLDS_ASSIGN@ -- see this file's top comment and HDRS above.
ICECREME_COMPILER_SLDS @SLDS_ASSIGN@

# stage 0: bin2c the COMMITTED seed into a throwaway binary. icecreme-boot.ice
# has NO build rule -- it's a checked-in source file (see .gitignore). This
# binary is never shipped, only used to self-compile stage 1.
embedded_icecreme_boot.c: icecreme-boot.ice tools/bin2c
	tools/bin2c icecreme-boot.ice creme_embedded_icecreme_ice > $@

# $(MAIN_SRC:.c=.o) $(COMMON_SRCS:.c=.o) is $(OBJS) minus embedded_icecreme.o
# (which embedded_icecreme_boot.o replaces below) -- the plain-concatenation
# equivalent of the old `$(filter-out embedded_icecreme.o,$(OBJS))`.
BOOT_OBJS := $(MAIN_SRC:.c=.o) $(COMMON_SRCS:.c=.o) embedded_icecreme_boot.o
icecreme-boot: $(BOOT_OBJS)
	$(CC) $(CREME_CFLAGS) $(CFLAGS) -o $@ $(BOOT_OBJS) $(CREME_LDFLAGS) $(LDFLAGS) $(LDLIBS) $$($(LDLIBS_GATED_SH))

# stage 1: the bootstrap binary self-compiles the shipped chunk from CURRENT
# source. --static makes it self-contained (inlines every imported .sld) so at
# the fixpoint icecreme.ice is byte-identical to icecreme-boot.ice. NOT --strip:
# dead-global elimination removes globals only reached through the reflective
# "compiler compiles its own source at runtime" path, which breaks
# spec/creme/compiler_self_host_spec.scm (the build-time --emit and ordinary
# programs don't exercise those, so they look fine -- but the shipped compiler
# must). This is what makes the build self-hosting AND always reflect current
# icecreme.scm/*.sld.
icecreme.ice: icecreme.scm $(ICECREME_COMPILER_SLDS) icecreme-boot
	cd .. && ./icecreme/icecreme-boot --emit-icecreme --static icecreme/icecreme.scm icecreme/icecreme.ice

embedded_icecreme.c: icecreme.ice tools/bin2c
	tools/bin2c icecreme.ice creme_embedded_icecreme_ice > $@

# embedded_icecreme.c already comes in via $(SRCS) now (see its comment
# above), so it's not repeated here -- only embed.c stays a library-only
# addition (main.c never calls its creme_run_scheme_file/creme_run_repl API).
# $(COMMON_SRCS) $(EMBED_SRC) is $(SRCS) minus main.c (was `filter-out main.c`),
# plus embed.c (the library-only host API).
LIBCREME_SRCS := $(COMMON_SRCS) $(EMBED_SRC) embed.c
LIBCREME_OBJS := $(LIBCREME_SRCS:.c=.lib.o)

.PHONY: lib
lib: libcreme.a

libcreme.a: $(LIBCREME_OBJS)
	ar rcs $@ $(LIBCREME_OBJS)

.c.lib.o:
	$(CC) $(CREME_CFLAGS) $(CFLAGS) -fPIC -c -o $@ $<

# ---- Vendored deps (git submodules) ----------------------------------------
# vendor/{sds,picohttpparser,verstable} are git submodules pinned in .gitmodules
# (repo root). A fresh checkout that skipped `git clone --recursive` gets them
# auto-initialized on first build: the source files below are object
# prerequisites, and their rule runs `git submodule update --init`. One primary
# target (sds.c) inits all three; the others just declare the dependency with an
# empty `@:` recipe so nothing re-inits.
VENDOR_HDRS = vendor/sds/sds.h vendor/picohttpparser/picohttpparser.h vendor/verstable/verstable.h

vendor/sds/sds.c:
	cd .. && git submodule update --init icecreme/vendor/sds icecreme/vendor/picohttpparser icecreme/vendor/verstable
vendor/sds/sds.h vendor/picohttpparser/picohttpparser.c vendor/picohttpparser/picohttpparser.h vendor/verstable/verstable.h: vendor/sds/sds.c
	@:

# sds selects its allocator by including sdsalloc.h, whose upstream form is an
# UNCONDITIONAL `#define s_malloc malloc` (no include guard), so a `-Ds_malloc=...`
# on the command line just gets redefined back to libc. The hook sds actually
# offers is that header itself. sds.c includes it as `#include "sdsalloc.h"`,
# resolved from the compiled file's OWN directory -- so we stage sds.c/sds.h into
# $(SDS_STAGE) next to a generated sdsalloc.h that routes through Boehm GC, and
# compile there. The pinned submodule stays byte-for-byte pristine; strings.c/
# mux.c include only sds.h (declarations) via -Ivendor/sds, so they're unaffected.
$(SDS_STAGE)/sds.c: vendor/sds/sds.c vendor/sds/sds.h
	mkdir -p $(SDS_STAGE)
	cp vendor/sds/sds.c vendor/sds/sds.h $(SDS_STAGE)/
	printf '#include <gc.h>\n#define s_malloc GC_MALLOC\n#define s_realloc GC_REALLOC\n#define s_free GC_FREE\n' > $(SDS_STAGE)/sdsalloc.h

.PHONY: vendor
vendor: $(SDS_STAGE)/sds.c vendor/picohttpparser/picohttpparser.c $(VENDOR_HDRS)

# The shared header prerequisite the suffix rules can't carry inline: every
# object set rebuilds when any local header changes, and the vendored headers
# here make a fresh checkout auto-init its submodules before the first compile.
$(OBJS) $(SANITIZE_OBJS) $(FUZZ_OBJS) $(LIBCREME_OBJS) $(BOOT_OBJS): $(HDRS) $(VENDOR_HDRS)

# Refresh the committed bootstrap seed from the freshly built self-hosted
# compiler (no bin/creme). Run this after changing the compiler's codegen so the
# seed tracks it, then `make` + commit icecreme-boot.ice. At steady state this
# reproduces the identical seed (no git diff); it only changes after a real
# codegen change. See the self-hosting bootstrap comment above.
.PHONY: update-boot-seed
update-boot-seed: $(BIN)
	cd .. && ./icecreme/icecreme --emit-icecreme --static icecreme/icecreme.scm icecreme/icecreme-boot.ice
	@echo "Regenerated icecreme-boot.ice; run 'make' and commit it if it changed."

# Drops ONLY the DERIVED stage-0 artifacts (the throwaway boot binary and its
# bin2c'd source), forcing them to rebuild from the committed seed. Does NOT
# touch icecreme-boot.ice itself -- that's the checked-in seed, not derived.
.PHONY: bootstrap-clean
bootstrap-clean:
	rm -f icecreme-boot embedded_icecreme_boot.c embedded_icecreme_boot.o

clean:
	rm -f $(OBJS) $(SANITIZE_OBJS) $(FUZZ_OBJS) $(LIBCREME_OBJS) $(BIN) $(SANBIN) $(FUZZBIN) libcreme.a
	rm -f tools/bin2c embedded_icecreme.c
	rm -f icecreme-boot embedded_icecreme_boot.c embedded_icecreme_boot.o icecreme.ice
	rm -rf fuzz/corpus $(SDS_STAGE)
