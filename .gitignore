/docs/
/lib/
/bin/
/.shards/
*.dwarf
crystal-run-*.tm.core
*.core
/competition/bench.html
/competition/bench/prof.html
/competition/lua/bench/monotonic.so

/icecreme/icecreme
/icecreme/icecreme-sanitize
/icecreme/fuzz-loader
/icecreme/icecreme.dSYM/
/icecreme/*.o
# icecreme/vendor/{sds,picohttpparser,verstable} are git submodules (tracked via
# .gitmodules), so the tree itself is NOT ignored. Their in-tree build objects
# are hidden by `ignore = untracked` in .gitmodules. sds compiles from a
# generated staging dir (below) so its submodule stays pristine.
/icecreme/sds-gc/
/icecreme/repl.ice
/icecreme/icecreme.ice
/icecreme/icecreme-boot
# icecreme-boot.ice is the COMMITTED bootstrap seed (a --static compiler image)
# -- stage 0 reads it instead of running the native bin/creme, so a fresh
# checkout builds icecreme with no Crystal toolchain. Refresh via
# `make -C icecreme update-boot-seed`. NOT ignored.
/icecreme/fuzz/corpus/
/icecreme/crash-*
/icecreme/oom-*
/icecreme/timeout-*

# libcreme.a build artifacts: the archive itself, the bin2c-generated
# source it bundles the compiler bytecode from, and the bin2c helper
# binary itself -- see icecreme/Makefile's own comment.
/icecreme/libcreme.a
/icecreme/embedded_icecreme.c
/icecreme/embedded_icecreme_boot.c
/icecreme/tools/bin2c

# examples/libcream/'s own build output.
/examples/libcream/host_demo

# (creme ffi)'s small precompiled dlopen/libffi shim (see ffi_shim.c's own
# header comment) -- built by the root Makefile's ffi_shim.o rule, same
# convention as /icecreme/*.o above.
/src/creme/modules/creme/ffi_shim.o

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock

# SQLite test-db files (e.g. spec/scheme/modules/raft_scheme_spec.cr's own
# on-disk store) -- WAL-mode leaves -shm/-wal siblings behind even after
# the main file is cleaned up by spec teardown.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
